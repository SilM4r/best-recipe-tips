<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="best_recipe_tips.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Spacing="25"
            Padding="30,0"
            VerticalOptions="Center">

            <Label
                Text="Výtejte v receptovníku!!"
                SemanticProperties.HeadingLevel="Level1"
                FontSize="32"
                HorizontalOptions="Center" />

            <HorizontalStackLayout
                HorizontalOptions="Center">
                <Entry
                x:Name="vyhledavac"
                HorizontalOptions="Center"
                WidthRequest="300"/>

                <Button
                x:Name="CounterBtn"
                Text="Vyhledat"
                Clicked="OnCounterClicked"
                HorizontalOptions="Center" />
            </HorizontalStackLayout>

            <Button
                Text="Pokročilé vyhledávání"
                Clicked="AdvancedSearchBtn"
                HorizontalOptions="Center" />
            <Button
                x:Name="MenuBtnname"
                Text="Jídelníček (0)"
                Clicked="MenuBtn"
                HorizontalOptions="Center" />



        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
